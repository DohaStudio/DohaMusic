APP_NAME=DohaMusic Backend
DATABASE_URL=sqlite:///./backend/storage/doha_music.db
AUDIO_STORAGE_ROOT=backend/storage
DOHAMUSIC_MUSIC_GENERATOR=mock
MODEL_NAME=mock-music-generator
MODEL_VERSION=mock
WORKER_MAX_THREADS=1
MOCK_GENERATION_DELAY_SECONDS=3
DOHAMUSIC_AI_ACE_STEP_RUNTIME_PYTHON=
DOHAMUSIC_AI_ACE_STEP_RUNNER_PATH=ai_worker/scripts/run_ace_step_smoke_test.py
DOHAMUSIC_AI_ACE_STEP_PROJECT_ROOT=
DOHAMUSIC_AI_ACE_STEP_CHECKPOINT_PATH=
DOHAMUSIC_AI_ACE_STEP_MODEL_VARIANT=acestep-v15-turbo
DOHAMUSIC_AI_ACE_STEP_MODEL_VERSION=v0.1.8
DOHAMUSIC_AI_ACE_STEP_DEVICE=cuda
DOHAMUSIC_AI_ACE_STEP_QUANTIZATION=int8_weight_only
DOHAMUSIC_AI_ACE_STEP_CPU_OFFLOAD=true
DOHAMUSIC_AI_ACE_STEP_DIT_CPU_OFFLOAD=true
DOHAMUSIC_AI_ACE_STEP_TIMEOUT_SECONDS=900
LOG_LEVEL=INFO
